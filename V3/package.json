{
  "name": "cc4-embedded-system",
  "version": "3.3.0",
  "description": "A modern typescript version of makefsdata based on html-minifier-next and lwIP v1.3.1",
  "bin": {
    "cc4es": "dist/gui.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/gui.ts",
    "build": "tsc && xcopy /E /I /Y public dist\\public",
    "test": "tsc && node --test \"test/*.test.mjs\"",
    "demo:prepare": "node demo/prepare.mjs",
    "demo:build": "tsc && node demo/build.mjs",
    "demo:test": "node --test --test-concurrency=1 demo/test.mjs",
    "demo:serve": "node demo/serve.mjs",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md",
    "licenses/"
  ],
  "keywords": [
    "lwip",
    "makefsdata",
    "stm32",
    "embedded-system",
    "html-minifier",
    "html-minifier-next",
    "html-compressor"
  ],
  "author": "LunaticGhoulPiano",
  "license": "MIT",
  "dependencies": {
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "html-minifier-next": "^9.1.1",
    "lightningcss": "^1.33.0",
    "open": "^11.0.4",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
