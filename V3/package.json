{
  "name": "cc4-embedded-system",
  "version": "3.2.1",
  "description": "A modern typescript version of makefsdata based on html-minifier-next and lwIP v1.3.1",
  "bin": {
    "cc4es": "dist/gui.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/gui.ts",
    "build": "tsc && xcopy /E /I /Y public dist\\public",
    "test": "tsc && node --test",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "lwip",
    "makefsdata",
    "stm32",
    "embedded-system",
    "html-minifier",
    "html-minifier-next",
    "html-compressor"
  ],
  "author": "LunaticGhoulPiano",
  "license": "MIT",
  "dependencies": {
    "esbuild": "^0.27.7",
    "express": "^5.2.1",
    "html-minifier-next": "^6.1.2",
    "lightningcss": "^1.32.0",
    "open": "^11.0.0",
    "svgo": "^4.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/open": "^6.1.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
